# MGC Sales Assistant - environment configuration
# Copy this file to `.env` and fill in your real Gemini API key.
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_api_key_here"

# Gemini chat/generation model (configurable, keep current-supported identifier).
GEMINI_MODEL=gemini-2.5-flash

# Gemini text embedding model.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Retrieval setting: how many chunks to return per query.
TOP_K=5

# Minimum cosine similarity for the best retrieved chunk before we answer.
# Below this the assistant abstains ("not enough information in the documents").
MIN_RELEVANCE_SCORE=0.60

# Paths (relative to project root).
DOCS_DIR=docs
VECTORSTORE_DIR=vectorstore
FAISS_INDEX_FILE=index.faiss
